# ---------------------------------------------------------------------------
# Smart Police Station - backend environment (PLACEHOLDERS ONLY)
# Copy to `.env` for local development. NEVER commit the real `.env`.
# In production (Render) set these in the dashboard instead of using a file.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Render injects PORT automatically in production; do not set it there.
PORT=4000

# MongoDB. Local:  mongodb://127.0.0.1:27017/smart-police-station
# Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-police-station?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart-police-station

# Redis. Local: redis://127.0.0.1:6379  |  Redis Cloud: redis://default:<password>@<host>:<port>
# (use rediss:// if your Redis Cloud endpoint has TLS enabled)
REDIS_URL=redis://127.0.0.1:6379

# RabbitMQ. Local: amqp://127.0.0.1:5672  |  CloudAMQP: amqps://<user>:<password>@<host>/<vhost>
RABBITMQ_URL=amqp://127.0.0.1:5672

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They MUST be different from each other. Minimum 32 characters in production.
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed by CORS / Socket.IO. No trailing slash.
# Production example: https://smart-police-web.onrender.com
# Multiple origins may be comma-separated.
CLIENT_URL=http://localhost:5173
# Public URL of THIS backend, WITHOUT /api (used to build upload file URLs).
# Production example: https://smart-police-api.onrender.com
API_BASE_URL=http://localhost:4000

# Optional integrations (leave empty to disable)
GOOGLE_MAPS_API_KEY=
AI_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Used ONLY by `npm run seed:admin`
ADMIN_NAME=Control Room Admin
ADMIN_EMAIL=admin@smartpolice.local
ADMIN_PASSWORD=replace_me

# Optional tuning
# TRUST_PROXY=1            # reverse-proxy hops (defaults to 1 in production)
# DNS_SERVERS=1.1.1.1,8.8.8.8  # override DNS used for mongodb+srv lookups
# SOS_NEARBY_RADIUS_KM=5
# SOS_EXPANDED_RADIUS_KM=20
# SOS_LOCATION_FRESHNESS_MINUTES=10
# SOS_ACK_TIMEOUT_SECONDS=60
