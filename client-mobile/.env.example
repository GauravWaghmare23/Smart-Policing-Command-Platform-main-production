# Expo mobile app. EXPO_PUBLIC_* values are embedded in the app bundle and are PUBLIC.
# Never put secrets in EXPO_PUBLIC_* variables.

# Development (Expo Go / physical phone): localhost will NOT work on a real device.
# Use your computer's LAN IP, e.g. http://192.168.1.50:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Production builds do NOT read this file. Set it as an EAS environment variable:
#   eas env:create --environment production --name EXPO_PUBLIC_API_URL \
#     --value https://<render-backend-url>/api --visibility plaintext
