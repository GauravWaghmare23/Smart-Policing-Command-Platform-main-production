# Web client (Vite). Every VITE_* value is PUBLIC - it is embedded in the browser bundle.
# Never put backend secrets here.

# Development:
VITE_API_URL=http://localhost:4000/api
# Production (set in Render Static Site -> Environment, then redeploy):
# VITE_API_URL=https://<render-backend-url>/api

# Optional: only if Socket.IO is hosted somewhere other than the API host.
# Defaults to VITE_API_URL without the trailing /api.
# VITE_SOCKET_URL=http://localhost:4000

# Google Maps JavaScript API key. Public by design: restrict it in Google Cloud
# Console to your frontend's HTTP referrer(s) and to the Maps JavaScript API only.
VITE_GOOGLE_MAPS_API_KEY=
